<Window x:Class="Glance.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="知隙 · Glance" Width="420" Height="116" MinWidth="340" MinHeight="116"
        FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="10" />
  </WindowChrome.WindowChrome>
  <Border BorderBrush="#DFDFEA" BorderThickness="1" Background="#FAFAFC" CornerRadius="9" Padding="12,8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="28" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="26" />
      </Grid.RowDefinitions>
      <Grid MouseLeftButtonDown="DragHeader">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#6255CA" CornerRadius="5" Width="20" Height="20">
            <TextBlock Text="知" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="知隙" Margin="6,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="ModeLabel" Grid.Column="1" FontSize="10" Foreground="{StaticResource Muted}"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0,4,0" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="历史" Click="OpenHistory" ToolTip="搜索与回顾本机记录" Padding="6,3" FontSize="11" />
          <Button Content="设置" Click="OpenSettings" Padding="6,3" FontSize="11" />
          <Button Content="×" Click="HideWindow" ToolTip="收起到托盘 · Esc" Padding="7,1" FontSize="16" />
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="0,4,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
        <TextBox x:Name="Question" AutomationProperties.Name="查询问题" AutomationProperties.HelpText="输入词汇、概念或问题；Enter 查询"
                 FontSize="14" Padding="9,6" MaxLength="6000" MinHeight="38" UndoLimit="20"
                 PreviewKeyDown="QuestionKeyDown" TextChanged="QuestionChanged" />
        <TextBlock Text="查询词汇、概念或问题…" Margin="10,0,0,0" FontSize="13" Foreground="#9393A4"
                   IsHitTestVisible="False" VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers><DataTrigger Binding="{Binding Text.Length, ElementName=Question}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <Button x:Name="AskButton" Grid.Column="1" Content="↵" AutomationProperties.Name="查询"
                ToolTip="查询 · Enter" Style="{StaticResource Primary}" Click="Ask" Margin="5,0,0,0" Padding="0" FontSize="18" />
      </Grid>
      <Border x:Name="AnswerPanel" Grid.Row="2" Visibility="Collapsed" Background="White"
              BorderBrush="#E7E7EF" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,8,0,2">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <TextBlock x:Name="AnswerLabel" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,5" />
          <TextBox Grid.Row="1" x:Name="Answer" AutomationProperties.Name="回答内容" IsReadOnly="True"
                   IsUndoEnabled="False" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   BorderThickness="0" Padding="0" FontSize="14" Background="Transparent"
                   AcceptsReturn="True" VerticalContentAlignment="Top" />
        </Grid>
      </Border>
      <Grid Grid.Row="3">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="ShortcutLabel" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" />
        <TextBlock x:Name="Status" Grid.Column="1" Text="Enter 查询 · Esc 收起" Foreground="{StaticResource Muted}"
                   FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"
                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="StopButton" Content="停止" Click="Stop" Visibility="Collapsed" Padding="6,2" FontSize="11" />
          <Button x:Name="CopyButton" Content="复制" Click="CopyAnswer" Visibility="Collapsed" Padding="6,2" FontSize="11" />
          <Button x:Name="NewButton" Content="清空" Click="NewQuery" ToolTip="清空并恢复紧凑浮窗" Visibility="Collapsed" Padding="6,2" FontSize="11" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
