<Window x:Class="Glance.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="知隙 · Glance" Width="540" Height="590" MinWidth="400" MinHeight="420" FontFamily="Microsoft YaHei UI" FontSize="13" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="True">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" /></WindowChrome.WindowChrome>
  <Border BorderBrush="#DFDFEA" BorderThickness="1" Background="#FAFAFC" CornerRadius="10" Padding="23,0,23,16">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid MouseLeftButtonDown="DragHeader">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#6255CA" CornerRadius="8" Width="28" Height="28"><TextBlock Text="知" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border><TextBlock Text="知隙" Margin="9,0,7,0" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Text="GLANCE" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" /></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="历史" Click="OpenHistory" ToolTip="搜索与回顾本机记录" Padding="9,6" /><Button Content="设置" Click="OpenSettings" Padding="9,6" /><Button Content="×" Click="HideWindow" ToolTip="收起到托盘 · Esc" Padding="10,5" FontSize="17" /></StackPanel>
      </Grid>
      <StackPanel Grid.Row="1" Margin="0,10,0,16"><TextBlock Text="看懂这一刻，继续手边的事。" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="ModeLabel" Text="单轮查询 · 流式回答 · 本机历史" Foreground="{StaticResource Muted}" Margin="0,8,0,0" /></StackPanel>
      <Grid Grid.Row="2" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="Question" AutomationProperties.Name="查询问题" ToolTip="输入词汇、概念或问题；Enter 查询" FontSize="16" MaxLength="6000" MinHeight="47" VerticalContentAlignment="Center" PreviewKeyDown="QuestionKeyDown" TextChanged="QuestionChanged" /><Button x:Name="AskButton" Grid.Column="1" Content="查询 ↵" Style="{StaticResource Primary}" Click="Ask" Margin="9,0,0,0" Padding="16,9" /></Grid>
      <Border Grid.Row="3" Background="White" BorderBrush="#E7E7EF" BorderThickness="1" CornerRadius="9" Padding="16">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock x:Name="AnswerLabel" Text="一个问题，一次理解" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,10" /><TextBox Grid.Row="1" x:Name="Answer" AutomationProperties.Name="回答内容" Text="输入一个词汇、概念或问题。&#10;&#10;按 Enter 获取简明解释，按 Esc 返回工作。&#10;首次使用，请在设置中添加 API Key。" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="0" FontSize="15" Background="Transparent" AcceptsReturn="True" VerticalContentAlignment="Top" /></Grid>
      </Border>
      <Grid Grid.Row="4" Margin="0,12,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="准备就绪" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" /><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="StopButton" Content="停止" Click="Stop" Visibility="Collapsed" /><Button x:Name="CopyButton" Content="复制" Click="CopyAnswer" IsEnabled="False" /><Button x:Name="NewButton" Content="新查询" Click="NewQuery" /></StackPanel></Grid>
      <Grid Grid.Row="5"><TextBlock x:Name="ShortcutLabel" Text="Ctrl + Alt + Space 唤起" Foreground="{StaticResource Muted}" FontSize="10" /><TextBlock Text="ESC 收起   ·   本机保存" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right" /></Grid>
    </Grid>
  </Border>
</Window>
