<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Glance</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/glance.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <!-- This WPF entry point owns DPI through its manifest; Forms is used only for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Glance.Core/Glance.Core.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/glance.ico" /></ItemGroup>
</Project>
